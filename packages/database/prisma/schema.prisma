datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ----------------------------------------------------
// Enums
// ----------------------------------------------------

enum RoleType {
  FARMER
  CONTRACTOR
  TRACTOR_OWNER
  SKILLED_WORKER
  EQUIPMENT_OWNER
  SUPPLIER
  // Future & Institutional roles (Section 14)
  DRIVER
  MECHANIC
  SERVICE_PROVIDER
  BUYER
  ADMIN
  FIELD_AGENT
  FPO
  COOPERATIVE
  GOVERNMENT
  NGO
  INSTITUTION
  FIELD_OFFICER
  TRANSPORT_PROVIDER
  LOGISTICS_OPERATOR
}

enum VerificationStatus {
  UNVERIFIED
  VERIFIED
  GOLD
  PLATINUM
}

enum ResourceType {
  TRACTOR
  WORKER
  EQUIPMENT
}

enum AvailabilityStatus {
  AVAILABLE
  BOOKED
  MAINTENANCE
  UNAVAILABLE
}

enum EquipmentType {
  SPRAYER
  PUMP
  WATER_PUMP
  AGRICULTURAL_MACHINE
  OTHER
}

enum LandType {
  IRRIGATED
  DRYLAND
  WETLAND
  MIXED
}

enum IrrigationType {
  BOREWELL
  CANAL
  DRIP
  SPRINKLER
  RAIN_FED
  OTHER
}

enum TractorCategory {
  COMPACT
  MEDIUM
  HEAVY
}

enum AttachmentType {
  ROTAVATOR
  CULTIVATOR
  PLOUGH
  SEED_DRILL
  TRAILER
  LEVELLER
  HARROW
  THRESHER
  SPRAYER
  OTHER
}

enum InputProductCategory {
  FERTILIZERS
  SEEDS
  CROP_PROTECTION
  MICRONUTRIENTS
  AGRICULTURAL_SUPPLIES
}

enum RequestStatus {
  OPEN
  MATCHED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum BookingStatus {
  REQUESTED
  MATCHED
  QUOTED
  ACCEPTED
  SCHEDULED
  WORK_STARTED
  WORK_COMPLETED
  PAYMENT
  RATING
  CLOSED
  CANCELLED
  DISPUTED
  NO_SHOW
  RESCHEDULED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum PaymentMethod {
  UPI
  BANK_TRANSFER
  WALLET
  CASH
  CARD
}

enum CommunicationChannel {
  IN_APP
  SMS
  WHATSAPP
  IVR_AGENT
}

// ----------------------------------------------------
// 0. Location & Spatial Master
// ----------------------------------------------------

model Location {
  id        String   @id @default(uuid())
  village   String
  mandal    String
  district  String
  state     String   @default("Telangana")
  pincode   String?
  latitude  Float
  longitude Float
  createdAt DateTime @default(now())

  farms                Farm[]
  projects             Project[]
  supplierProfiles     SupplierProfile[]
  equipment            Equipment[]
  workRequests         WorkRequest[]
  organizations        Organization[]
  programLocations     ProgramLocation[]
  procurementRequests  ProcurementRequest[]
  produceListings      ProduceListing[]
  vehiclesBased        Vehicle[]            @relation("VehicleBaseLocation")
  transportStops       TransportStop[]
  transportRequestsOrigin TransportRequest[] @relation("PickupLocation")
  transportRequestsDest   TransportRequest[] @relation("DeliveryLocation")

  @@index([district, mandal, village])
  @@index([latitude, longitude])
}

// ----------------------------------------------------
// 1. Users, User Roles & Current Preferences (Sections 11 & 12)
// ----------------------------------------------------

model User {
  id                 String             @id @default(uuid())
  phone              String             @unique
  name               String
  email              String?            @unique
  status             String             @default("active") // active, suspended, pending
  profileImageUrl    String?
  verificationTier   Int                @default(0) // 0: Mobile, 1: Identity, 2: Document, 3: History, 4: Trusted
  rating             Float              @default(0.0)
  totalRatingsCount  Int                @default(0)
  disputeCount       Int                @default(0)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  // Multi-Role & Preferences (User != Role)
  roles              UserRoleEntry[]
  preference         UserPreference?

  // Specific Persona Profiles
  farmerProfile      FarmerProfile?
  contractorProfile  ContractorProfile?
  tractorOwner       TractorOwnerProfile?
  skilledWorker      WorkerProfile?
  equipmentOwner     EquipmentOwnerProfile?
  supplierProfile    SupplierProfile?

  // Audits & Reviews
  reviewsGiven       Rating[]           @relation("ReviewsGiven")
  reviewsReceived    Rating[]           @relation("ReviewsReceived")
  communicationLogs  CommunicationLog[]

  // AI Subsystem (Milestone 13)
  aiConversations    AIConversation[]
  aiRecommendations  AIRecommendation[]
  aiFeedbacks        AIFeedback[]

  // Institutional Network (Milestone 14)
  organizationMemberships OrganizationMember[]
  createdOrganizations    Organization[]       @relation("CreatedOrganizations")
  createdPrograms         Program[]            @relation("CreatedPrograms")
  programParticipations   ProgramParticipant[]
  createdProcurements     ProcurementRequest[] @relation("CreatedProcurements")
  buyerProfile            BuyerProfile?

  // Logistics & Supply Chain (Milestone 15)
  driverProfile            DriverProfile?
  vehiclesOwned            Vehicle[]              @relation("OwnedVehicles")
  transportRequestsCreated TransportRequest[]     @relation("CustomerTransportRequests")
  transportOffersReceived  TransportOffer[]       @relation("ProviderTransportOffers")
  transportBookingsAsCust  TransportBooking[]     @relation("CustomerTransportBookings")
  deliveriesConfirmed      DeliveryConfirmation[] @relation("ConfirmedDeliveries")
}

model UserRoleEntry {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      RoleType
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([userId, role])
  @@index([userId])
  @@index([role])
}

model UserPreference {
  id                String   @id @default(uuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentRole       RoleType @default(FARMER)
  preferredLanguage String   @default("Telugu")
  theme             String   @default("light")
  updatedAt         DateTime @updatedAt
}

// ----------------------------------------------------
// 2. Farmer Database & Farms (Section 13)
// ----------------------------------------------------

model FarmerProfile {
  id                String          @id @default(uuid())
  userId            String          @unique
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  preferredLanguage String          @default("Telugu")
  experienceYears   Int             @default(0)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  farms             Farm[]
}


model Farm {
  id             String         @id @default(uuid())
  farmerId       String
  farmer         FarmerProfile  @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  name           String         // e.g. "North Field", "Village Borewell Plot"
  area           Float          // e.g. 4.0
  areaUnit       String         @default("acres")
  locationId     String
  location       Location       @relation(fields: [locationId], references: [id])
  crop           String         // e.g. "Cotton", "Paddy"
  irrigationType IrrigationType @default(BOREWELL)
  landType       LandType       @default(IRRIGATED)
  surveyNumber   String?
  createdAt      DateTime       @default(now())

  organizationFarms OrganizationFarm[]
  produceListings   ProduceListing[]

  @@index([farmerId])
  @@index([locationId])
}

// ----------------------------------------------------
// 3. Contractor Database & Projects (Section 14)
// ----------------------------------------------------

model ContractorProfile {
  id                 String             @id @default(uuid())
  userId             String             @unique
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName       String             // e.g. "Sri Sai Agri Contracting"
  experienceYears    Int                @default(0)
  serviceRadius      Float              @default(25.0) // km
  description        String?
  verificationStatus VerificationStatus @default(UNVERIFIED)
  rating             Float              @default(0.0)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  projects           Project[]
}

model Project {
  id                    String                         @id @default(uuid())
  contractorId          String?
  contractor            ContractorProfile?             @relation(fields: [contractorId], references: [id], onDelete: SetNull)
  organizationId        String?
  organization          Organization?                  @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  programId             String?
  program               Program?                       @relation(fields: [programId], references: [id], onDelete: SetNull)
  title                 String                         // e.g. "Village X agricultural operation"
  description           String?
  locationId            String
  location              Location                       @relation(fields: [locationId], references: [id])
  totalAcreage          Float                          @default(50.0)
  startDate             DateTime
  endDate               DateTime
  status                String                         @default("open") // open, in_progress, completed, cancelled
  fulfillmentPercentage Float                          @default(0.0)
  createdAt             DateTime                       @default(now())
  updatedAt             DateTime                       @updatedAt

  requirements          ProjectRequirement[]

  @@index([contractorId])
  @@index([organizationId])
  @@index([programId])
  @@index([locationId])
  @@index([status])
}

model ProjectRequirement {
  id                String   @id @default(uuid())
  projectId         String
  project           Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  category          String   // "tractor", "worker", "sprayer", "equipment"
  specName          String   // e.g. "50 HP Tractor", "Sprayer Operator"
  quantityRequired  Int      @default(1)
  quantityFulfilled Int      @default(0)
  unitRateBudget    Float    @default(0.0)

  @@index([projectId])
}

// ----------------------------------------------------
// 4. Tractor Owner, Tractors & Attachments (Sections 15 & 16)
// ----------------------------------------------------

model TractorOwnerProfile {
  id                 String             @id @default(uuid())
  userId             String             @unique
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  verificationStatus VerificationStatus @default(UNVERIFIED)
  rating             Float              @default(0.0)
  completedJobs      Int                @default(0)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  tractors           Tractor[]
}

model Tractor {
  id                 String              @id @default(uuid())
  ownerId            String
  owner              TractorOwnerProfile @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  registrationNumber String?             @unique // e.g. "TS34AB1234"
  brand              String?             // e.g. "Mahindra", "John Deere", "Swaraj"
  model              String?             // e.g. "Arjun 550 DI"
  hp                 Int?                // e.g. 50, 45, 35
  manufacturingYear  Int?                // purchase / manufacturing year
  year               Int?                // alias for manufacturing year
  condition          String?             @default("good") // excellent, good, fair
  verificationStatus VerificationStatus  @default(UNVERIFIED)
  status             String              @default("ACTIVE") // ACTIVE, maintenance, retired
  baseRatePerAcre    Float?              @default(950.0)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  attachments        TractorAttachment[]

  @@index([ownerId])
  @@index([hp])
}

model TractorAttachment {
  id             String         @id @default(uuid())
  tractorId      String
  tractor        Tractor        @relation(fields: [tractorId], references: [id], onDelete: Cascade)
  attachmentType AttachmentType // ROTAVATOR, CULTIVATOR, PLOUGH, TRAILER, SEED_DRILL
  brand          String?
  condition      String?        @default("good")
  status         String         @default("ACTIVE")
  perAcreRate    Float?         @default(350.0)
  createdAt      DateTime       @default(now())

  @@index([tractorId])
  @@index([attachmentType])
}

// ----------------------------------------------------
// 5. Skilled Workers, Skills & Worker Skills (Section 17)
// ----------------------------------------------------

model WorkerProfile {
  id                 String             @id @default(uuid())
  userId             String             @unique
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  experienceYears    Int?               @default(0)
  serviceRadiusKm    Float?             @default(10.0) // km
  serviceRadius      Float?             @default(10.0) // km
  expectedDailyRate  Float?             @default(550.0) // INR
  dailyRate          Float?             @default(550.0) // INR
  verificationStatus VerificationStatus @default(UNVERIFIED)
  rating             Float              @default(0.0)
  completedJobs      Int                @default(0)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  skills             WorkerSkill[]
}

model Skill {
  id       String        @id @default(uuid())
  name     String        @unique // e.g. "Tractor Operator", "Sprayer Operator", "Pump Technician"
  category String        // e.g. "Machinery Operation", "Crop Care", "Irrigation"

  workers  WorkerSkill[]
}

model WorkerSkill {
  id              String        @id @default(uuid())
  workerId        String
  worker          WorkerProfile @relation(fields: [workerId], references: [id], onDelete: Cascade)
  skillId         String
  skill           Skill         @relation(fields: [skillId], references: [id], onDelete: Cascade)
  experienceYears Int?          @default(1)

  @@unique([workerId, skillId])
  @@index([workerId])
  @@index([skillId])
}

// ----------------------------------------------------
// 6. Generic Equipment & Equipment Owners (Section 18)
// ----------------------------------------------------

model EquipmentOwnerProfile {
  id                 String             @id @default(uuid())
  userId             String             @unique
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  experienceYears    Int?               @default(0)
  verificationStatus VerificationStatus @default(UNVERIFIED)
  rating             Float              @default(0.0)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  equipment          Equipment[]
}

model Equipment {
  id               String                @id @default(uuid())
  ownerId          String
  owner            EquipmentOwnerProfile @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  type             EquipmentType         @default(OTHER) // SPRAYER, PUMP, WATER_PUMP, OTHER
  equipmentType    EquipmentType         @default(OTHER)
  brand            String?               // e.g. "Aspee", "Kirloskar", "Neptune"
  model            String?               // e.g. "HTP-35", "BS-16"
  capacity         String?               // e.g. "35 LPM", "7.5 HP", "16 Litres"
  condition        String?               @default("good")
  locationId       String?
  location         Location?             @relation(fields: [locationId], references: [id])
  rentalRatePerDay Float?                @default(1200.0)
  status           String                @default("ACTIVE")
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@index([ownerId])
  @@index([equipmentType])
}

// ----------------------------------------------------
// 7. Supplier & Products (Section 19)
// ----------------------------------------------------

model SupplierProfile {
  id                 String             @id @default(uuid())
  userId             String             @unique
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName       String             // e.g. "Sri Venkateshwara Agri Inputs"
  shopName           String
  locationId         String
  location           Location           @relation(fields: [locationId], references: [id])
  fertilizerLicense  String?
  seedLicense        String?
  verificationStatus VerificationStatus @default(UNVERIFIED)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  products           Product[]
  quotes             SupplierQuote[]

  @@index([locationId])
}

model Product {
  id          String               @id @default(uuid())
  supplierId  String
  supplier    SupplierProfile      @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  name        String               // e.g. "Urea (Neem Coated)", "Cotton Seed Hybrid"
  category    InputProductCategory
  unit        String               // "50 kg bag", "1 Litre bottle"
  price       Float                // e.g. 266.50
  stockStatus String               @default("in_stock") // in_stock, low_stock, out_of_stock
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([supplierId])
  @@index([category])
}

// ----------------------------------------------------
// 8. Unified Common Availability Engine (Section 20)
// ----------------------------------------------------

model Availability {
  id           String             @id @default(uuid())
  resourceType ResourceType       // TRACTOR, WORKER, EQUIPMENT
  resourceId   String             // ID of Tractor, WorkerProfile, or Equipment
  date         DateTime           // Date of availability slot
  startTime    String             @default("07:00")
  endTime      String             @default("17:00")
  status       AvailabilityStatus @default(AVAILABLE)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([resourceType, resourceId])
  @@index([date, status])
}

// ----------------------------------------------------
// 9. Work Requests, Work Requirements & Bookings (Sections 21–25)
// ----------------------------------------------------

model WorkRequest {
  id            String            @id @default(uuid())
  referenceCode String            @unique // e.g. "TRW-000124", "REQ-1001"
  createdBy     String
  requestType   String            // "TRACTOR_WORK", "SKILLED_WORKER", "SPRAY_PUMP", "CONTRACTOR_WORK"
  locationId    String
  location      Location          @relation(fields: [locationId], references: [id])
  requestedDate DateTime
  startTime     String            @default("07:00")
  endTime       String            @default("17:00")
  status        RequestStatus     @default(OPEN)
  description   String?
  createdAt     DateTime          @default(now())

  requirements  WorkRequirement[]
  bookings      Booking[]

  @@index([status])
  @@index([referenceCode])
  @@index([locationId])
}

model WorkRequirement {
  id             String          @id @default(uuid())
  requestId      String
  request        WorkRequest     @relation(fields: [requestId], references: [id], onDelete: Cascade)
  resourceType   ResourceType    // TRACTOR, WORKER, EQUIPMENT
  quantity       Int             @default(1)
  skillId        String?
  equipmentType  EquipmentType?
  tractorHpMin   Int?            // e.g. 45 HP
  attachmentType AttachmentType? // e.g. ROTAVATOR, PLOUGH

  @@index([requestId])
}

model Booking {
  id            String        @id @default(uuid())
  referenceCode String        @unique // e.g. "BKG-000124"
  requestId     String?
  request       WorkRequest?  @relation(fields: [requestId], references: [id])
  providerId    String        // User ID or Profile ID of provider
  providerType  RoleType      // TRACTOR_OWNER, SKILLED_WORKER, EQUIPMENT_OWNER, CONTRACTOR
  customerId    String        // User ID of customer (Farmer or Contractor)
  customerType  RoleType      // FARMER, CONTRACTOR
  scheduledDate DateTime
  startTime     String        @default("07:00")
  endTime       String        @default("17:00")
  agreedPrice   Float         // Total agreed price INR
  status        BookingStatus @default(REQUESTED) // REQUESTED, SCHEDULED, ARRIVED, WORK_STARTED, WORK_COMPLETED, CONFIRMED
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  payment       Payment?
  rating        Rating?
  workSessions  WorkSession[]
  disputes      Dispute[]

  @@index([providerId])
  @@index([customerId])
  @@index([status])
}

model WorkSession {
  id           String    @id @default(uuid())
  bookingId    String
  booking      Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  startedAt    DateTime  @default(now())
  completedAt  DateTime?
  actualHours  Float?
  actualArea   Float?    // acres
  notes        String?
  status       String    @default("started") // started, completed, confirmed

  @@index([bookingId])
}

model Payment {
  id            String        @id @default(uuid())
  bookingId     String        @unique
  booking       Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  amount        Float
  status        PaymentStatus @default(PENDING)
  paymentMethod PaymentMethod @default(UPI)
  transactionId String?       @unique
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Rating {
  id         String   @id @default(uuid())
  bookingId  String   @unique
  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  fromUserId String
  fromUser   User     @relation("ReviewsGiven", fields: [fromUserId], references: [id])
  toUserId   String
  toUser     User     @relation("ReviewsReceived", fields: [toUserId], references: [id])
  rating     Float    // e.g. 4.7
  review     String?  // Review comment
  createdAt  DateTime @default(now())

  @@index([fromUserId])
  @@index([toUserId])
}

model Dispute {
  id             String    @id @default(uuid())
  bookingId      String
  booking        Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  raisedByUserId String
  reason         String    // "no_show", "incomplete_work", "rate_dispute"
  description    String
  status         String    @default("open")
  refundAmount   Float?
  resolvedAt     DateTime?
  createdAt      DateTime  @default(now())

  @@index([bookingId])
}

model CommunicationLog {
  id             String               @id @default(uuid())
  recipientId    String
  recipient      User                 @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  channel        CommunicationChannel @default(SMS)
  title          String
  body           String
  referenceCode  String?
  timestamp      DateTime             @default(now())

  @@index([recipientId])
}

// ----------------------------------------------------
// 13. AI Intelligence & Assistant Subsystem (Milestone 13)
// ----------------------------------------------------

enum AIMessageRole {
  USER
  ASSISTANT
  SYSTEM
  TOOL
}

enum AIRecommendationType {
  FARM_ACTIVITY
  RESOURCE
  PRICE
  SUPPLIER
  DEMAND
  SUPPLY
  INVENTORY
}

enum AIRecommendationStatus {
  GENERATED
  VIEWED
  ACCEPTED
  REJECTED
  EXPIRED
}

enum AIConfidenceLevel {
  HIGH
  MEDIUM
  LOW
}

model AIConversation {
  id          String      @id @default(uuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  contextType String?
  contextId   String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  messages    AIMessage[]

  @@index([userId])
  @@map("ai_conversations")
}

model AIMessage {
  id             String         @id @default(uuid())
  conversationId String
  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           AIMessageRole  @default(USER)
  content        String
  metadata       Json?
  createdAt      DateTime       @default(now())

  @@index([conversationId])
  @@map("ai_messages")
}

model AIRecommendation {
  id            String                 @id @default(uuid())
  userId        String
  user          User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          AIRecommendationType
  referenceType String?
  referenceId   String?
  title         String
  description   String
  confidence    AIConfidenceLevel      @default(MEDIUM)
  status        AIRecommendationStatus @default(GENERATED)
  metadata      Json?
  createdAt     DateTime               @default(now())
  expiresAt     DateTime?
  feedbacks     AIFeedback[]

  @@index([userId])
  @@index([type])
  @@map("ai_recommendations")
}

model AIFeedback {
  id               String           @id @default(uuid())
  userId           String
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  recommendationId String
  recommendation   AIRecommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
  rating           String // "UPVOTE", "DOWNVOTE", "USEFUL", "NOT_USEFUL"
  feedback         String?
  createdAt        DateTime         @default(now())

  @@index([userId])
  @@index([recommendationId])
  @@map("ai_feedbacks")
}

// ----------------------------------------------------
// 14. Government, FPO, Cooperative & Institutional Network (Milestone 14)
// ----------------------------------------------------

enum OrganizationType {
  FPO
  COOPERATIVE
  GOVERNMENT
  NGO
  INSTITUTION
  CUSTOM
}

enum OrgMembershipRole {
  ADMIN
  MANAGER
  FIELD_OFFICER
  MEMBER
  OBSERVER
}

enum OrgFarmRelationship {
  OWNED
  MEMBER_FARM
  PROGRAM_ATTACHED
}

enum ProgramType {
  GOVERNMENT_SUBSIDY
  FPO_SCHEME
  NGO_INITIATIVE
  SEASONAL_DRIVE
  EQUIPMENT_MECHANIZATION
}

enum ProgramStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum ProgramCoverageType {
  STATE
  DISTRICT
  MANDAL
  VILLAGE
}

enum ProcurementStatus {
  DRAFT
  OPEN
  QUOTED
  AWARDED
  IN_PROGRESS
  FULFILLED
  CANCELLED
}

enum SupplierQuoteStatus {
  SUBMITTED
  UNDER_REVIEW
  ACCEPTED
  REJECTED
  EXPIRED
}

enum BuyerType {
  INSTITUTIONAL
  AGGREGATOR
  FOOD_PROCESSOR
  EXPORTER
  RETAIL_CHAIN
}

enum ProduceListingStatus {
  AVAILABLE
  PARTIALLY_SOLD
  SOLD
  EXPIRED
  CANCELLED
}

model Organization {
  id                  String               @id @default(uuid())
  name                String               // e.g. "Kalyandurg Farmer Producer Co. Ltd."
  code                String               @unique // e.g. "FPO-KD-001"
  type                OrganizationType     @default(FPO)
  registrationNumber  String?              // CIN/Govt Reg number
  description         String?
  primaryContactPhone String?
  primaryContactEmail String?
  locationId          String
  location            Location             @relation(fields: [locationId], references: [id])
  createdById         String
  creator             User                 @relation("CreatedOrganizations", fields: [createdById], references: [id])
  status              String               @default("active") // active, suspended, pending
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  members             OrganizationMember[]
  farms               OrganizationFarm[]
  programs            Program[]
  projects            Project[]
  procurements        ProcurementRequest[]
  produceListings     ProduceListing[]
  vehicles            Vehicle[]
  transportRequests   TransportRequest[]

  @@index([type])
  @@index([locationId])
  @@index([code])
}

model OrganizationMember {
  id             String            @id @default(uuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           OrgMembershipRole @default(MEMBER)
  joinedAt       DateTime          @default(now())
  status         String            @default("active") // active, inactive, pending_approval
  permissions    Json?             // Granular RBAC permissions overrides

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@index([role])
}

model OrganizationFarm {
  id             String              @id @default(uuid())
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  farmId         String
  farm           Farm                @relation(fields: [farmId], references: [id], onDelete: Cascade)
  relationship   OrgFarmRelationship @default(MEMBER_FARM)
  attachedAt     DateTime            @default(now())

  @@unique([organizationId, farmId])
  @@index([organizationId])
  @@index([farmId])
}

model Program {
  id             String               @id @default(uuid())
  organizationId String
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code           String               @unique // e.g. "PRG-TEL-2026-FARM-MECH"
  name           String               // e.g. "Rythu Bandhu Mechanization & Spraying Drive"
  description    String?
  type           ProgramType          @default(GOVERNMENT_SUBSIDY)
  status         ProgramStatus        @default(ACTIVE)
  budgetTotal    Float                @default(0.0) // Budget allocation in INR
  budgetSpent    Float                @default(0.0)
  subsidyRate    Float                @default(0.0) // percentage e.g. 50.0%
  startDate      DateTime
  endDate        DateTime
  createdById    String
  creator        User                 @relation("CreatedPrograms", fields: [createdById], references: [id])
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  locations      ProgramLocation[]
  participants   ProgramParticipant[]
  projects       Project[]

  @@index([organizationId])
  @@index([status])
  @@index([type])
}

model ProgramLocation {
  id           String              @id @default(uuid())
  programId    String
  program      Program             @relation(fields: [programId], references: [id], onDelete: Cascade)
  locationId   String
  location     Location            @relation(fields: [locationId], references: [id])
  coverageType ProgramCoverageType @default(MANDAL)

  @@unique([programId, locationId])
  @@index([programId])
  @@index([locationId])
}

model ProgramParticipant {
  id            String    @id @default(uuid())
  programId     String
  program       Program   @relation(fields: [programId], references: [id], onDelete: Cascade)
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  enrolledAt    DateTime  @default(now())
  subsidyClaimed Float    @default(0.0)
  status        String    @default("enrolled") // enrolled, approved, rejected, completed

  @@unique([programId, userId])
  @@index([programId])
  @@index([userId])
}

model ProcurementRequest {
  id              String                   @id @default(uuid())
  code            String                   @unique // e.g. "PROC-2026-0042"
  organizationId  String
  organization    Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title           String                   // e.g. "Bulk Monsoon Fertilizer Supply (1200 Bags Urea + DAP)"
  description     String?
  targetBudget    Float                    @default(0.0)
  deliveryLocationId String
  deliveryLocation Location                @relation(fields: [deliveryLocationId], references: [id])
  status          ProcurementStatus        @default(OPEN)
  biddingDeadline DateTime
  createdById     String
  creator         User                     @relation("CreatedProcurements", fields: [createdById], references: [id])
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  requirements    ProcurementRequirement[]
  quotes          SupplierQuote[]

  @@index([organizationId])
  @@index([status])
  @@index([deliveryLocationId])
}

model ProcurementRequirement {
  id            String             @id @default(uuid())
  procurementId String
  procurement   ProcurementRequest @relation(fields: [procurementId], references: [id], onDelete: Cascade)
  itemCategory  String             // "FERTILIZER", "SEED", "PESTICIDE", "EQUIPMENT", "CUSTOM"
  itemName      String             // "Neem Coated Urea (50kg)"
  quantity      Float              // 1200
  unit          String             // "bags", "litres", "units"
  specifications String?

  @@index([procurementId])
}

model SupplierQuote {
  id             String              @id @default(uuid())
  procurementId  String
  procurement    ProcurementRequest  @relation(fields: [procurementId], references: [id], onDelete: Cascade)
  supplierId     String
  supplier       SupplierProfile     @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  quoteAmount    Float               // Total quote in INR
  deliveryDays   Int                 @default(3) // Delivery within N days
  notes          String?
  status         SupplierQuoteStatus @default(SUBMITTED)
  validUntil     DateTime
  submittedAt    DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([procurementId])
  @@index([supplierId])
  @@index([status])
}

model BuyerProfile {
  id                 String             @id @default(uuid())
  userId             String             @unique
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName        String             // e.g. "Deccan Agri Aggregators Pvt Ltd"
  buyerType          BuyerType          @default(AGGREGATOR)
  gstNumber          String?
  contactPhone       String?
  verificationStatus VerificationStatus @default(UNVERIFIED)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([buyerType])
}

model ProduceListing {
  id             String               @id @default(uuid())
  code           String               @unique // e.g. "PRD-2026-0089"
  organizationId String?
  organization   Organization?        @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  farmId         String?
  farm           Farm?                @relation(fields: [farmId], references: [id], onDelete: SetNull)
  crop           String               // "Cotton (Long Staple)", "Sona Masoori Paddy"
  quantity       Float                // 50.0
  unit           String               @default("Quintals")
  targetPrice    Float                // 7200 INR per Quintal
  qualityGrade   String?              // "Grade A", "Standard"
  harvestDate    DateTime?
  locationId     String
  location       Location             @relation(fields: [locationId], references: [id])
  status         ProduceListingStatus @default(AVAILABLE)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([organizationId])
  @@index([farmId])
  @@index([locationId])
  @@index([crop])
  @@index([status])
}

// ----------------------------------------------------
// 15. Logistics, Transportation & Agricultural Supply Chain (Milestone 15)
// ----------------------------------------------------

enum VehicleType {
  TRACTOR
  TRACTOR_TRAILER
  MINI_TRUCK
  TRUCK
  PICKUP
  TANKER
  TEMPO
  OTHER
}

enum VehicleStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
  SUSPENDED
}

enum DriverStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum TransportRequestType {
  INPUT_DELIVERY
  PRODUCE_TRANSPORT
  EQUIPMENT_TRANSPORT
  WATER_TRANSPORT
  PERSON_TRANSPORT
  GENERAL_CARGO
  OTHER
}

enum TransportStopType {
  PICKUP
  DELIVERY
  WAYPOINT
}

enum TransportOfferStatus {
  OFFERED
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
}

enum TransportBookingStatus {
  CONFIRMED
  DRIVER_ASSIGNED
  VEHICLE_ASSIGNED
  READY
  PICKED_UP
  IN_TRANSIT
  DELIVERED
  COMPLETED
  CANCELLED
  DISPUTED
}

enum TripStatus {
  PLANNED
  STARTED
  IN_TRANSIT
  COMPLETED
  CANCELLED
}

enum DeliveryEvidenceType {
  PHOTO
  DOCUMENT
  SIGNATURE
  OTP
}

model Vehicle {
  id                 String             @id @default(uuid())
  ownerId            String
  owner              User               @relation("OwnedVehicles", fields: [ownerId], references: [id], onDelete: Cascade)
  organizationId     String?
  organization       Organization?      @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  vehicleType        VehicleType        @default(MINI_TRUCK)
  registrationNumber String             @unique // e.g. "TS-08-UB-4821"
  brand              String             // e.g. "Mahindra", "Eicher", "Tata"
  model              String             // e.g. "Bolero Maxi Truck", "Pro 2049", "575 DI + 5T Trailer"
  manufacturingYear  Int?
  capacity           Float              // Maximum payload capacity
  capacityUnit       String             @default("kg") // "kg", "quintals", "tonnes", "litres"
  condition          String             @default("good")
  status             VehicleStatus      @default(ACTIVE)
  baseLocationId     String
  baseLocation       Location           @relation("VehicleBaseLocation", fields: [baseLocationId], references: [id])
  serviceRadiusKm    Float              @default(35.0)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  vehicleDrivers     VehicleDriver[]
  transportOffers    TransportOffer[]
  transportBookings  TransportBooking[]

  @@index([ownerId])
  @@index([organizationId])
  @@index([vehicleType])
  @@index([status])
  @@index([baseLocationId])
}

model DriverProfile {
  id                 String             @id @default(uuid())
  userId             String             @unique
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  licenseType        String             // "LMV_COMMERCIAL", "HMV_HEAVY", "TRACTOR_TRAILER"
  licenseNumber      String             @unique // e.g. "DL-TS-2024-884912"
  licenseExpiry      DateTime
  experienceYears    Int                @default(0)
  serviceRadiusKm    Float              @default(30.0)
  verificationStatus VerificationStatus @default(UNVERIFIED)
  rating             Float              @default(0.0)
  status             DriverStatus       @default(ACTIVE)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  vehicleDrivers     VehicleDriver[]
  transportOffers    TransportOffer[]
  transportBookings  TransportBooking[]

  @@index([licenseType])
  @@index([status])
  @@index([verificationStatus])
}

model VehicleDriver {
  id          String        @id @default(uuid())
  vehicleId   String
  vehicle     Vehicle       @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  driverId    String
  driver      DriverProfile @relation(fields: [driverId], references: [id], onDelete: Cascade)
  isPrimary   Boolean       @default(true)
  validFrom   DateTime      @default(now())
  validUntil  DateTime?
  createdAt   DateTime      @default(now())

  @@unique([vehicleId, driverId])
  @@index([vehicleId])
  @@index([driverId])
}

model TransportRequest {
  id                 String                 @id @default(uuid())
  code               String                 @unique // e.g. "TRQ-2026-0001"
  createdById        String
  creator            User                   @relation("CustomerTransportRequests", fields: [createdById], references: [id], onDelete: Cascade)
  organizationId     String?
  organization       Organization?          @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  requestType        TransportRequestType   @default(PRODUCE_TRANSPORT)
  pickupLocationId   String
  pickupLocation     Location               @relation("PickupLocation", fields: [pickupLocationId], references: [id])
  deliveryLocationId String
  deliveryLocation   Location               @relation("DeliveryLocation", fields: [deliveryLocationId], references: [id])
  requestedDate      DateTime
  pickupStartTime    String                 @default("07:00")
  pickupEndTime      String                 @default("17:00")
  description        String?
  status             String                 @default("OPEN") // OPEN, MATCHED, IN_TRANSIT, DELIVERED, CANCELLED
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  requirements       TransportRequirement[]
  stops              TransportStop[]
  offers             TransportOffer[]
  bookings           TransportBooking[]

  @@index([createdById])
  @@index([organizationId])
  @@index([requestType])
  @@index([status])
  @@index([pickupLocationId])
  @@index([deliveryLocationId])
}

model TransportRequirement {
  id                      String           @id @default(uuid())
  transportRequestId      String
  transportRequest        TransportRequest @relation(fields: [transportRequestId], references: [id], onDelete: Cascade)
  cargoType               String           // "Cotton", "Neem Urea Bags", "Paddy", "Spraying Equipment", "Water"
  quantity                Float            // e.g. 5000.0
  unit                    String           @default("kg") // "kg", "quintals", "bags", "litres"
  vehicleType             VehicleType      @default(TRUCK)
  minimumCapacity         Float            // e.g. 6000.0
  requiredVehicleFeatures String?          // "Tarpaulin Covered", "Drop Side", "High Suspension"
  specialInstructions     String?

  @@index([transportRequestId])
}

model TransportStop {
  id                 String            @id @default(uuid())
  transportRequestId String
  transportRequest   TransportRequest  @relation(fields: [transportRequestId], references: [id], onDelete: Cascade)
  sequence           Int               @default(1)
  stopType           TransportStopType @default(PICKUP)
  locationId         String
  location           Location          @relation(fields: [locationId], references: [id])
  plannedArrival     DateTime?
  plannedDeparture   DateTime?
  actualArrival      DateTime?
  actualDeparture    DateTime?
  status             String            @default("PLANNED") // PLANNED, ARRIVED, DEPARTED, SKIPPED

  @@index([transportRequestId])
  @@index([locationId])
}

model TransportOffer {
  id                 String               @id @default(uuid())
  transportRequestId String
  transportRequest   TransportRequest     @relation(fields: [transportRequestId], references: [id], onDelete: Cascade)
  providerId         String
  provider           User                 @relation("ProviderTransportOffers", fields: [providerId], references: [id], onDelete: Cascade)
  vehicleId          String
  vehicle            Vehicle              @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  driverId           String?
  driver             DriverProfile?       @relation(fields: [driverId], references: [id], onDelete: SetNull)
  price              Float                // Total offered transportation price in INR
  currency           String               @default("INR")
  message            String?
  expiresAt          DateTime
  status             TransportOfferStatus @default(OFFERED)
  submittedAt        DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  booking            TransportBooking?

  @@index([transportRequestId])
  @@index([providerId])
  @@index([vehicleId])
  @@index([driverId])
  @@index([status])
}

model TransportBooking {
  id                 String                 @id @default(uuid())
  referenceCode      String                 @unique // e.g. "TBK-2026-0001"
  transportRequestId String
  transportRequest   TransportRequest       @relation(fields: [transportRequestId], references: [id], onDelete: Cascade)
  offerId            String?                @unique
  offer              TransportOffer?        @relation(fields: [offerId], references: [id], onDelete: SetNull)
  customerId         String
  customer           User                   @relation("CustomerTransportBookings", fields: [customerId], references: [id], onDelete: Cascade)
  providerId         String                 // Provider User ID
  vehicleId          String
  vehicle            Vehicle                @relation(fields: [vehicleId], references: [id])
  driverId           String?
  driver             DriverProfile?         @relation(fields: [driverId], references: [id], onDelete: SetNull)
  priceQuoteId       String?
  status             TransportBookingStatus @default(CONFIRMED)
  scheduledAt        DateTime
  agreedPrice        Float                  // Total agreed trip cost in INR
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  trips              Trip[]

  @@index([transportRequestId])
  @@index([customerId])
  @@index([providerId])
  @@index([vehicleId])
  @@index([status])
}

model Trip {
  id                    String                 @id @default(uuid())
  transportBookingId    String
  transportBooking      TransportBooking       @relation(fields: [transportBookingId], references: [id], onDelete: Cascade)
  startedAt             DateTime               @default(now())
  completedAt           DateTime?
  actualDistanceKm      Float?
  actualDurationMinutes Int?
  status                TripStatus             @default(PLANNED)
  notes                 String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  deliveryConfirmations DeliveryConfirmation[]

  @@index([transportBookingId])
  @@index([status])
}

model DeliveryConfirmation {
  id                String               @id @default(uuid())
  tripId            String
  trip              Trip                 @relation(fields: [tripId], references: [id], onDelete: Cascade)
  confirmedById     String
  confirmedBy       User                 @relation("ConfirmedDeliveries", fields: [confirmedById], references: [id], onDelete: Cascade)
  confirmedAt       DateTime             @default(now())
  quantityDelivered Float                // Actual received quantity
  unit              String               @default("kg")
  evidenceType      DeliveryEvidenceType @default(OTP)
  evidenceData      String?              // Photo URL, document hash, or signature string
  otpCode           String?              // 4-digit verification OTP
  notes             String?

  @@index([tripId])
  @@index([confirmedById])
}



